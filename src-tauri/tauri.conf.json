{
  "productName": "Time-cut",
  "version": "0.1.0-preview.42",
  "identifier": "app.timecut.album",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../src-vite build",
    "beforeDevCommand": "pnpm --dir ../src-vite dev",
    "devUrl": "http://localhost:3580",
    "frontendDist": "../src-vite/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPLOCALDATA/**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "active": true,
    "category": "Graphics and Design",
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/models/text_model.onnx": "models/text_model.onnx",
      "resources/models/vision_model.onnx": "models/vision_model.onnx",
      "resources/models/tokenizer.json": "models/tokenizer.json",
      "resources/models/face_detection_yunet_2026may.onnx": "models/face_detection_yunet_2026may.onnx",
      "resources/models/face_recognition_sface_2021dec.onnx": "models/face_recognition_sface_2021dec.onnx",
      "resources/models/YuNet-LICENSE.txt": "licenses/YuNet-LICENSE.txt",
      "resources/models/SFace-LICENSE.txt": "licenses/SFace-LICENSE.txt",
      "resources/ffmpeg/*": "ffmpeg",
      "../THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
    }
  }
}
